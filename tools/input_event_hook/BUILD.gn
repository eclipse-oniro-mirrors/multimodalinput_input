import("//build/ohos.gni")
import("../../multimodalinput_mini.gni")

# 端到端验证 OH_Input_EventHandler_* / OH_Input_Event_* NDK 接口的命令行工具：
# 启动后向 MMI 服务注册输入事件 Hook，在回调中打印命中的事件详情。
ohos_executable("input_event_hook") {
  defines = input_default_defines
  sources = [ "src/main.cpp" ]
  configs = [ "${mmi_path}:coverage_flags" ]
  include_dirs = [ "${mmi_path}/interfaces/kits/c/input" ]
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  deps = [ "${mmi_path}/frameworks/native/input:oh_input_manager" ]
  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
  ]
  subsystem_name = "multimodalinput"
  part_name = "input"
}
